// Flutter/Release.xcconfig
#include "Generated.xcconfig"

// شاهد (لاگ CI، job «Flutter iOS IPA»، run 38918346666): دستور شکست‌خورده
//   builtin-precompileModule …/ExplicitPrecompiledModules/firebase_messaging-*.scan
// هنوز `-Wnon-modular-include-in-framework-module
//  -Werror=non-modular-include-in-framework-module` داشت، در حالی که CompileC خودِ
// pod هدفِ firebase_messaging (که post_install در Podfile تنظیمش می‌کند) این جفتِ
// فلگ را نداشت. پس مالکِ این precompile هدفِ **Runner** است (تعریف‌های
// `COCOAPODS=1`/`PB_*` هم از `Pods-Runner.release.xcconfig` به اینجا می‌آیند) و
// اهرمِ pod-level به آن نمی‌رسد.
//
// `CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES` روی هدفِ برنامه import
// غیرماژولاری `Pods/Headers/Public/Firebase/Firebase.h` را (که
// firebase_messaging-14.9.4 داخل ماژول خودش انجام می‌دهد) از خطا به اخطار تبدیل
// می‌کند. بعد از `#include` نوشته می‌شود تا روی مقادیر تولیدشدهٔ فلاتر بماند و
// چون در `Runner.xcodeproj` این کلید تعریف نشده، همین xcconfig مرجع است.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
