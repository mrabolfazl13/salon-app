# Database
DATABASE_URL=postgresql://futsal:secret@postgres:5432/futsal_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Admin
ADMIN_PHONE=09123456789
ADMIN_PASSWORD=admin123

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,tauri://localhost,http://tauri.localhost

# SMS (Optional)
SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER=
# --- حرینگی/توسعه (Hotfix یکپارتچگی) ---
# محیط اجرا: production ⇒ create_all خاموش (فقط Alembic)
APP_ENV=development
# ساخت خودکار جداول در حالت توسعه (false ⇒ حتی در توسعه هم فقط Alembic)
AUTO_CREATE_ALL=true
# لاگ SQL
DB_ECHO=false
# افشای کد OTP در پاسخ API (dev_code) — هرگز در production روشن نکنید
DEBUG_ALLOW_DEV_CODE=false
