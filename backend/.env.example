# backend/.env.example
# الگوی متغیرهای محیط بک‌اند — هر ۳۴ کلید واقعیِ `app/config.py` (بدون مقدار محرمانه)
# نحوهٔ استفاده: `cp .env.example .env` و سپس پر کردن مقادیر؛ مقدارهای نمونه را در
# production به‌کار نبرید (کارت بوت `validate_production_config` روی پیش‌فرض‌ها fail می‌کند).

# ── محیط اجرا ──
APP_ENV=development                 # development | production
AUTO_CREATE_ALL=false               # ساخت جدول فقط در توسعه؛ در production با Alembic
DB_ECHO=false                       # لاگ SQL
DEBUG_ALLOW_DEV_CODE=false          # افشای کد توسعه‌ای در پاسخ API

# ── دیتابیس و کش ──
DATABASE_URL=postgresql://futsal:CHANGE_ME@postgres:5432/futsal_db
REDIS_URL=redis://redis:6379/0

# ── احراز هویت / JWT ──
JWT_SECRET=                         # الزامی؛ حداقل ۳۲ کاراکتر تصادفی
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── حساب ادمین اولیه (بوت) ──
ADMIN_PHONE=09123456789
ADMIN_PASSWORD=                     # الزامی در production

# ── رزرو و قیمت ──
PENDING_BOOKING_TTL_HOURS=4
DEFAULT_SLOT_PRICE=200000           # ریال، مبنای تولید سانس

# ── تیم ──
TEAM_MAX_MEMBERS=50
TEAM_MIN_MEMBERS=5

# ── وفاداری ──
LOYALTY_RIALS_PER_POINT=10000
LOYALTY_REDEEM_MAX_PERCENT=50
LOYALTY_POINTS_PER_GAME_WIN=500
LOYALTY_POINTS_PER_REVIEW=50

# ── CRM ──
CRM_CAMPAIGN_DAILY_LIMIT=1

# ── محدودیت نرخ ──
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_FAIL_OPEN=true           # true=عبور هنگام قطعی Redis، false=پاسخ 503

# ── هدرهای امنیتی ──
ENABLE_HSTS=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ── CORS (فهرست comma-separated) ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── ورود خودکار کاربر عادی (تا راه‌اندازی کانال پیامک/ایمیل) ──
AUTO_VERIFY_USERS=false

# ── ایمیل (کد تأیید) — خالی ⇒ کد فقط لاگ می‌شود ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=futsal-booking@no-reply.local

# ── MinIO (object storage) ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=futsal-venues
MINIO_SECURE=false
MINIO_PUBLIC_URL=                   # خالی ⇒ از MINIO_ENDPOINT ساخته می‌شود

# ── درگاه پرداخت ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
