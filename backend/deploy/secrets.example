# ============================================================================
# Secrets Template for Production Deployment
# ============================================================================
# This file documents all required secrets and configuration for production.
# DO NOT commit actual values to version control!
#
# Usage: Copy this file, fill in real values, and load as environment variables
# or use with Docker secrets / Kubernetes secrets / CI secret storage.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# IMPORTANT: Use strong passwords, never use default credentials
DATABASE_URL=postgresql://futsal:<STRONG_PASSWORD>@postgres:5432/futsal_db

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# ----------------------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------------------
# MUST be at least 32 characters, cryptographically random
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<GENERATE_STRONG_SECRET_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ----------------------------------------------------------------------------
# Admin Account
# ----------------------------------------------------------------------------
ADMIN_PHONE=09123456789
# MUST be changed from 'admin123' - use strong password
# First login will force password change if still using default
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>

# ----------------------------------------------------------------------------
# CORS - Allowed Origins
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://salon.absadeghi.ir,https://api.salonsystem.ir

# ----------------------------------------------------------------------------
# MinIO Object Storage
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
# Change from defaults!
MINIO_ACCESS_KEY=<CHANGE_FROM_MINIOADMIN>
MINIO_SECRET_KEY=<CHANGE_FROM_DEFAULT>
MINIO_BUCKET=futsal-venues
MINIO_SECURE=true
# Public URL accessible by users (via Nginx reverse proxy with HTTPS)
MINIO_PUBLIC_URL=https://salon.absadeghi.ir/minio

# ----------------------------------------------------------------------------
# Payment Gateway (ZarinPal)
# ----------------------------------------------------------------------------
# Get merchant ID from ZarinPan panel: https://merchant.zarinpal.com
ZARINPAL_MERCHANT_ID=<YOUR_ZARINPAL_MERCHANT_ID>
# Set to false in production after testing
ZARINPAL_SANDBOX=false

# ----------------------------------------------------------------------------
# Email (SMTP) - For OTP verification
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@salonsystem.ir
SMTP_PASSWORD=<APP_PASSWORD_FROM_GMAIL>
SMTP_FROM=Futsal Booking <noreply@salonsystem.ir>

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
APP_ENV=production
AUTO_CREATE_ALL=false
DB_ECHO=false
DEBUG_ALLOW_DEV_CODE=false

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_HOUR=10

# ----------------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------------
ENABLE_HSTS=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

# ----------------------------------------------------------------------------
# Loyalty Points Configuration
# ----------------------------------------------------------------------------
LOYALTY_RIALS_PER_POINT=10000
LOYALTY_REDEEM_MAX_PERCENT=50
LOYALTY_POINTS_PER_GAME_WIN=500
LOYALTY_POINTS_PER_REVIEW=50

# ----------------------------------------------------------------------------
# CRM Campaign Limits
# ----------------------------------------------------------------------------
CRM_CAMPAIGN_DAILY_LIMIT=1

# ============================================================================
# Key Rotation Procedure
# ============================================================================
# 
# If a secret is compromised:
# 1. Generate new secret value
# 2. Update in secret storage (Docker secrets / K8s secrets / CI secrets)
# 3. Restart application containers
# 4. For JWT_SECRET: All existing tokens will be invalidated immediately
# 5. For MINIO keys: Update bucket policies and test access
# 6. For ADMIN_PASSWORD: Force admin to re-login with new password
# 7. Document rotation date and reason in security log
#
# ============================================================================
# Testing Configuration Validation
# ============================================================================
#
# Before deploying to production, validate your configuration:
#
#   cd backend
#   APP_ENV=production python -c "from app.config import settings; print('OK')"
#
# This will fail with clear error messages if any required secrets are missing
# or using default values.
#
# ============================================================================
