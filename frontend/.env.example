# frontend/.env.example
# الگوی متغیرهای محیط فرانت (Vite) — فقط همین پنج کلید در کد خوانده می‌شود
# نحوهٔ استفاده: `cp .env.example .env` (دِو) یا `.env.production` برای بیلد انتشار.
# توجه: هر VITE_* داخل باندل عمومی قرار می‌گیرد — هرگز کلید خصوصی اینجا نگذارید.

# مقصد API. در تولید همان origin با پروکسی nginx کافی است ⇒ مسیر نسبی بگذارید.
VITE_API_URL=/api/v1

# پروکسی دِو (فقط vite.config.ts؛ در بیلد تولید استفاده نمی‌شود)
VITE_PROXY_TARGET=http://localhost:8000

# نام نمایشی برنامه
VITE_APP_NAME=فوتسال

# نسخهٔ نمایشی (با نسخهٔ Tauri/APK هم‌خوان باشد)
VITE_APP_VERSION=1.2.0

# دامنهٔ نهایی، برای لینک‌های share و پیام‌های راهنما
VITE_DOMAIN=salon.absadeghi.ir
