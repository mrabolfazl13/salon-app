{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://salon.absadeghi.ir/*" },
        { "url": "https://salon.absadeghi.ir/*" },
        { "url": "http://api.salon.absadeghi.ir/*" },
        { "url": "https://api.salon.absadeghi.ir/*" },
        { "url": "https://api.iconify.design/*" },
        { "url": "https://api.simplesvg.com/*" },
        { "url": "https://api.unisvg.com/*" },
        { "url": "http://localhost/*" },
        { "url": "http://127.0.0.1/*" }
      ]
    }
  ]
}
